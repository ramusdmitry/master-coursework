# Но НЕ игнорируем каталоги исходного кода с именами data/ и models/
# (только сами файлы, не __pycache__ — он остаётся под общим правилом выше)
!pipeline/src/data/
!pipeline/src/data/*.py
!pipeline/src/models/
!pipeline/src/models/*.py
!checkpoint7/conf/data/
